# =============================================================================
# PGC — Plateforme de Gestion de Crise — Configuration d'environnement
# Copier ce fichier en `.env` (non committé) et renseigner les valeurs réelles.
# Règle impérative : aucune URL/port/clé/secret en dur dans le code — tout passe
# par ces variables (cf. GUIDE_NOUVELLE_APP_VILLE.md §1.1).
# =============================================================================

# --- Base de données PostgreSQL (Ville) -------------------------------------
# En dev local, le docker-compose fournit un service `postgres` avec ces mêmes
# valeurs. En prod, pointer vers le PostgreSQL partagé réel de la Ville.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=pgc_app
POSTGRES_PASSWORD=changeme_dev_only
PGC_SCHEMA=pgc

# --- API centrale APM (services transverses : mail, sms, AD, oracle...) -----
APM_API_URL=https://api.ivry.local
APM_API_KEY=

# --- API métier Hub DSI / DSIHUB (données Ville + fonctions métier) ---------
HUBDSI_API_URL=http://10.103.130.106:3001
HUBDSI_API_KEY=

# --- STUDIO RH (agents, organisation) ---------------------------------------
STUDIORH_API_URL=
STUDIORH_API_KEY=

# --- Analyse Mail (alertes, IOC) --------------------------------------------
ANALYSEMAIL_API_URL=
ANALYSEMAIL_API_KEY=

# --- APIRS (infrastructure) --------------------------------------------------
APIRS_API_URL=
APIRS_API_KEY=

# --- IA Locale (chat de crise, synthèse, RETEX, aide à la décision) ---------
# Confirmé : pas de serveur dédié — l'IA Locale répond sur la même API que
# l'APM. Laisser vide pour retomber automatiquement sur APM_API_URL/APM_API_KEY
# (voir backend/services/ia.js) ; ne renseigner que si un jour séparée de l'APM.
IA_API_URL=
IA_API_KEY=

# --- Certificats auto-signés (réseau interne Ville) -------------------------
# studiorh.ivry.local, analyse-mail.ivry.local, etc. utilisent des certificats
# auto-signés en interne. Mettre à true pour les accepter quand même (jamais
# pour un service public/externe).
VILLE_ALLOW_SELF_SIGNED_CERTS=false

# --- Microsoft Graph (Teams, M365) ------------------------------------------
# App Registration Azure AD dédiée (portal.azure.com), permissions
# APPLICATION (pas Delegated) avec consentement admin — voir README pour la
# procédure. Secret jamais exposé côté frontend.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Canal Teams dédié aux crises (équipe + canal) — alimente le bouton
# "Importer Teams" sur une fiche crise. Trouver les IDs via
# services/graph.js:findTeamByName() puis listChannels().
GRAPH_CRISIS_TEAM_ID=
GRAPH_CRISIS_CHANNEL_ID=

# --- Application backend -----------------------------------------------------
PORT=4610
JWT_SECRET=changeme_generate_a_long_random_secret
JWT_EXPIRES_IN=8h
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:4611,http://localhost:5173

# --- Compte de secours local (bootstrap, cf. §Auth du plan) ------------------
# Créé au démarrage si absent — permet de se connecter même si l'AD/APM est down.
LOCAL_ADMIN_USERNAME=admin.local
LOCAL_ADMIN_PASSWORD=changeme_dev_only

# --- Frontend (injecté au build Vite, jamais en dur dans les composants) ----
VITE_API_URL=http://localhost:4610
